# ==============================================================================
# Environment Configuration Template for ApexCare Hospital Management System
# Copy this file to '.env' and adjust the values according to your environment.
# ==============================================================================

# Server Network Port
PORT=5000

# Node Environment Mode ('development', 'production', or 'test')
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas URI or Local MongoDB instance)
# Local MongoDB instance:
MONGODB_URI=mongodb://127.0.0.1:27017/hospital_management
# MongoDB Atlas cluster example:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/hospital_management?retryWrites=true&w=majority

# JWT (JSON Web Token) Secret Key for Authentication Sessions
# IMPORTANT: Replace with a secure, randomly generated 64-character secret in production
JWT_SECRET=replace_with_your_custom_jwt_secret_key_for_production

# JWT Session Expiry Duration (e.g., '24h', '7d')
JWT_EXPIRES_IN=24h

# Optional Default Seed Administrator Credentials (used when running 'npm run seed')
# NOTE: These are development-only default credentials. Never use default passwords in production.
SEED_ADMIN_NAME=Super Administrator
SEED_ADMIN_EMAIL=admin@hospital.com
SEED_ADMIN_PASSWORD=Admin@123456
