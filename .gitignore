# ==============================================================================
# Git Ignore Configuration for ApexCare Hospital Appointment Management System
# ==============================================================================

# 1. Dependency Directories
node_modules/
jspm_packages/

# 2. Environment Variables & Credentials (CRITICAL: Never commit secrets)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# 3. Local Databases & Storage Engine Files
data/
data/db/
hospital_test_db/
*.lock
*.wt

# 4. Local Database Dumps & Backups
backups/

# 5. Academic Deliverables & Generation Artifacts (Kept locally, excluded from repo)
academic_deliverables/
*.docx
*.pptx
*.pdf

# 6. Test Coverage & Logs
coverage/
.nyc_output/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 7. Operating System & Editor Files
.DS_Store
Thumbs.db
ehthumbs.db
.vscode/
.idea/
